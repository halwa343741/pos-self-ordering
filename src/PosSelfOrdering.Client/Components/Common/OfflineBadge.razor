@using PosSelfOrdering.Client.State
@inject AppState AppStateInstance

@if (AppStateInstance.IsOffline)
{
    <div style="background: linear-gradient(90deg, #ef4444, #dc2626); color: #fff; padding: 6px 12px; font-size: 0.82rem; font-weight: 700; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px; z-index: 1000; position: sticky; top: 0;">
        <span>⚠️ Mode Offline: Menampilkan data lokal. Pesanan akan dikirim saat koneksi terhubung.</span>
    </div>
}
