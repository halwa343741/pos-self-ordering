<div class="error-state glass-panel animate-fade-in" style="margin: 20px 0; border-color: rgba(239, 68, 68, 0.4);">
    <div class="state-icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
        <span style="font-size: 1.8rem;">⚠️</span>
    </div>
    <h3 style="color: #f87171;">Terjadi Kendala</h3>
    <p style="color: #cbd5e1; max-width: 380px;">@Message</p>
    @if (OnRetry.HasDelegate)
    {
        <button class="btn btn-primary btn-sm" @onclick="OnRetry" style="margin-top: 10px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                <path d="M21 3v5h-5"/>
                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                <path d="M3 21v-5h5"/>
            </svg>
            Coba Lagi
        </button>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Gagal memuat data dari server.";
    [Parameter] public EventCallback OnRetry { get; set; }
}
