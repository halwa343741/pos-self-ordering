<div class="menu-grid">
    @for (int i = 0; i < Count; i++)
    {
        <div class="menu-card skeleton" style="height: 240px; border: none;">
            <div style="height: 140px; background: rgba(255,255,255,0.04);"></div>
            <div style="padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                <div style="height: 16px; width: 75%; background: rgba(255,255,255,0.06); border-radius: 4px;"></div>
                <div style="height: 12px; width: 50%; background: rgba(255,255,255,0.04); border-radius: 4px;"></div>
                <div style="height: 18px; width: 40%; background: rgba(255,255,255,0.08); border-radius: 4px; margin-top: 8px;"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 6;
}
