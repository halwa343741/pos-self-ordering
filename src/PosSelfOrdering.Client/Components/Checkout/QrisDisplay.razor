@using PosSelfOrdering.Client.Extensions
@implements IDisposable

<div class="glass-panel" style="padding: 24px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px;">
    <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-weight: 800; font-size: 1.2rem; color: #fff; letter-spacing: 0.1em; background: #dc2626; padding: 2px 10px; border-radius: 4px;">QRIS</span>
        <span style="font-size: 0.85rem; color: var(--text-secondary);">GOPAY, OVO, DANA, SHOPEEPAY, BCA, MANDIRI</span>
    </div>

    <!-- QR Code SVG Box -->
    <div style="background: #ffffff; padding: 16px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); display: inline-flex; flex-direction: column; align-items: center; gap: 8px;">
        <svg width="200" height="200" viewBox="0 0 200 200" style="display: block;">
            <!-- Outer border & corner squares -->
            <rect width="200" height="200" fill="#ffffff"/>
            <!-- Top Left Finder Pattern -->
            <rect x="15" y="15" width="45" height="45" fill="#000000"/>
            <rect x="22" y="22" width="31" height="31" fill="#ffffff"/>
            <rect x="29" y="29" width="17" height="17" fill="#000000"/>
            <!-- Top Right Finder Pattern -->
            <rect x="140" y="15" width="45" height="45" fill="#000000"/>
            <rect x="147" y="22" width="31" height="31" fill="#ffffff"/>
            <rect x="154" y="29" width="17" height="17" fill="#000000"/>
            <!-- Bottom Left Finder Pattern -->
            <rect x="15" y="140" width="45" height="45" fill="#000000"/>
            <rect x="22" y="147" width="31" height="31" fill="#ffffff"/>
            <rect x="29" y="154" width="17" height="17" fill="#000000"/>
            <!-- Simulated QR Data matrix cells -->
            <rect x="75" y="20" width="10" height="10" fill="#000000"/>
            <rect x="95" y="20" width="10" height="10" fill="#000000"/>
            <rect x="115" y="20" width="10" height="10" fill="#000000"/>
            <rect x="75" y="40" width="10" height="10" fill="#000000"/>
            <rect x="105" y="40" width="10" height="10" fill="#000000"/>
            <rect x="85" y="60" width="10" height="10" fill="#000000"/>
            <rect x="115" y="60" width="10" height="10" fill="#000000"/>
            <rect x="20" y="75" width="10" height="10" fill="#000000"/>
            <rect x="40" y="75" width="10" height="10" fill="#000000"/>
            <rect x="60" y="75" width="10" height="10" fill="#000000"/>
            <rect x="90" y="80" width="20" height="20" fill="#000000"/>
            <rect x="130" y="75" width="10" height="10" fill="#000000"/>
            <rect x="150" y="75" width="10" height="10" fill="#000000"/>
            <rect x="170" y="75" width="10" height="10" fill="#000000"/>
            <rect x="75" y="105" width="10" height="10" fill="#000000"/>
            <rect x="115" y="105" width="10" height="10" fill="#000000"/>
            <rect x="145" y="105" width="10" height="10" fill="#000000"/>
            <rect x="75" y="125" width="10" height="10" fill="#000000"/>
            <rect x="95" y="125" width="10" height="10" fill="#000000"/>
            <rect x="115" y="135" width="10" height="10" fill="#000000"/>
            <rect x="155" y="135" width="10" height="10" fill="#000000"/>
            <rect x="75" y="165" width="10" height="10" fill="#000000"/>
            <rect x="105" y="165" width="10" height="10" fill="#000000"/>
            <rect x="135" y="165" width="10" height="10" fill="#000000"/>
            <rect x="165" y="165" width="10" height="10" fill="#000000"/>
            <rect x="120" y="145" width="10" height="10" fill="#000000"/>
            <!-- Center Branding Logo Pin -->
            <rect x="85" y="85" width="30" height="30" rx="4" fill="#f59e0b"/>
            <text x="100" y="105" font-size="14" text-anchor="middle" fill="#000000" font-weight="bold">POS</text>
        </svg>

        <span style="font-size: 0.75rem; color: #475569; font-weight: 700;">NMID: ID1020268819201</span>
    </div>

    <div>
        <span style="font-size: 0.85rem; color: var(--text-secondary);">Total Tagihan:</span>
        <h3 style="font-size: 1.4rem; color: var(--color-primary); font-weight: 800;">@Amount.ToIdr()</h3>
    </div>

    <div style="background: var(--bg-surface-elevated); padding: 8px 16px; border-radius: var(--radius-full); display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-secondary);">
        <span>⏱️ Sisa Waktu Pembayaran:</span>
        <strong style="color: var(--color-warning);">@FormattedCountdown</strong>
    </div>

    <p style="font-size: 0.8rem; color: var(--text-muted); max-width: 320px; margin: 0;">
        Buka aplikasi mobile banking atau e-wallet apa saja di ponsel Anda, lalu pindai QR code di atas.
    </p>
</div>

@code {
    [Parameter, EditorRequired] public decimal Amount { get; set; }
    [Parameter] public DateTime ExpiresAtUtc { get; set; } = DateTime.UtcNow.AddMinutes(15);
    [Parameter] public EventCallback OnExpired { get; set; }

    private TimeSpan _remainingTime = TimeSpan.FromMinutes(15);
    private PeriodicTimer? _timer;

    private string FormattedCountdown => $"{_remainingTime.Minutes:D2}:{_remainingTime.Seconds:D2}";

    protected override async Task OnInitializedAsync()
    {
        _remainingTime = ExpiresAtUtc - DateTime.UtcNow;
        if (_remainingTime < TimeSpan.Zero) _remainingTime = TimeSpan.Zero;

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunTimerAsync();
    }

    private async Task RunTimerAsync()
    {
        if (_timer is null) return;

        while (await _timer.WaitForNextTickAsync())
        {
            _remainingTime = ExpiresAtUtc - DateTime.UtcNow;
            if (_remainingTime <= TimeSpan.Zero)
            {
                _remainingTime = TimeSpan.Zero;
                await InvokeAsync(StateHasChanged);
                if (OnExpired.HasDelegate)
                {
                    await OnExpired.InvokeAsync();
                }
                break;
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
