@using PosSelfOrdering.Client.DTOs.Admin
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (IsOpen && Table != null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="table-qr-modal-container glass-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="header-left">
                    <span class="header-icon">🪑</span>
                    <h3>Stiker QR Meja @Table.TableNumber</h3>
                </div>
                <button type="button" class="close-btn" @onclick="Close">✕</button>
            </div>

            <div class="modal-body">
                <!-- PRINT-READY TABLE STICKER -->
                <div class="sticker-card">
                    <div class="sticker-top">
                        <span class="brand-name">⚡ KEDAI J.A</span>
                        <span class="brand-tag">SELF-ORDERING MENU</span>
                    </div>

                    <div class="table-number-banner">
                        <span class="tbl-label">MEJA</span>
                        <span class="tbl-val">@Table.TableNumber</span>
                    </div>

                    <!-- DYNAMIC QR CODE DISPLAY -->
                    <div class="qr-code-box">
                        <!-- High-contrast crisp SVG QR Code Simulation -->
                        <svg viewBox="0 0 200 200" width="160" height="160" class="qr-svg">
                            <rect width="200" height="200" fill="#ffffff" />
                            <!-- QR Positional Patterns -->
                            <!-- Top Left -->
                            <rect x="15" y="15" width="50" height="50" fill="#000" />
                            <rect x="23" y="23" width="34" height="34" fill="#fff" />
                            <rect x="31" y="31" width="18" height="18" fill="#000" />
                            <!-- Top Right -->
                            <rect x="135" y="15" width="50" height="50" fill="#000" />
                            <rect x="143" y="23" width="34" height="34" fill="#fff" />
                            <rect x="151" y="31" width="18" height="18" fill="#000" />
                            <!-- Bottom Left -->
                            <rect x="15" y="135" width="50" height="50" fill="#000" />
                            <rect x="23" y="143" width="34" height="34" fill="#fff" />
                            <rect x="31" y="151" width="18" height="18" fill="#000" />
                            <!-- Center Matrix Pattern -->
                            <rect x="75" y="20" width="10" height="10" fill="#000" />
                            <rect x="95" y="20" width="20" height="10" fill="#000" />
                            <rect x="75" y="40" width="20" height="10" fill="#000" />
                            <rect x="105" y="40" width="10" height="20" fill="#000" />
                            <rect x="20" y="75" width="30" height="10" fill="#000" />
                            <rect x="75" y="75" width="50" height="50" fill="#000" />
                            <rect x="85" y="85" width="30" height="30" fill="#fff" />
                            <rect x="95" y="95" width="10" height="10" fill="#000" />
                            <rect x="140" y="75" width="20" height="20" fill="#000" />
                            <rect x="170" y="75" width="15" height="10" fill="#000" />
                            <rect x="75" y="135" width="20" height="30" fill="#000" />
                            <rect x="105" y="145" width="30" height="20" fill="#000" />
                            <rect x="145" y="135" width="40" height="40" fill="#000" />
                            <rect x="155" y="145" width="20" height="20" fill="#fff" />
                            <!-- Brand Logo Dot in Center -->
                            <circle cx="100" cy="100" r="14" fill="#f59e0b" />
                            <text x="100" y="105" font-size="12" font-weight="bold" fill="#000" text-anchor="middle">JA</text>
                        </svg>
                    </div>

                    <div class="sticker-instructions">
                        <strong>Scan QR dengan Kamera HP</strong>
                        <span>Pesan & Bayar langsung tanpa antre di kasir</span>
                    </div>

                    <div class="sticker-url">
                        <span>@GetTableUrl()</span>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" @onclick="Close">Tutup</button>
                <button type="button" class="btn-print-sticker" @onclick="TriggerPrint">
                    <span>🖨️ Cetak Stiker Meja</span>
                </button>
            </div>
        </div>
    </div>
}

<style>
.table-qr-modal-container {
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    max-width: 440px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
}

.modal-body {
    padding: 24px;
    display: flex;
    justify-content: center;
    background: #0f172a;
}

.sticker-card {
    background: #ffffff;
    color: #111827;
    border-radius: 16px;
    padding: 20px;
    width: 100%;
    max-width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    border: 2px dashed #d1d5db;
}

.sticker-top {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
}

.brand-name {
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 1px;
    color: #0f172a;
}

.brand-tag {
    font-size: 0.65rem;
    font-weight: 800;
    color: #f59e0b;
    letter-spacing: 0.5px;
}

.table-number-banner {
    background: #0f172a;
    color: #fff;
    padding: 6px 20px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
}

.tbl-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #94a3b8;
}

.tbl-val {
    font-size: 1.2rem;
    font-weight: 900;
    color: #fbbf24;
}

.qr-code-box {
    padding: 8px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    margin-bottom: 12px;
}

.sticker-instructions {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
}

.sticker-instructions strong {
    font-size: 0.85rem;
    color: #111827;
}

.sticker-instructions span {
    font-size: 0.72rem;
    color: #6b7280;
}

.sticker-url {
    font-family: monospace;
    font-size: 0.68rem;
    color: #9ca3af;
    background: #f3f4f6;
    padding: 4px 8px;
    border-radius: 6px;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.btn-print-sticker {
    flex: 2;
    padding: 10px;
    border-radius: 10px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    border: none;
    color: #000;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
}
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public TableStatusDto? Table { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetTableUrl()
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        return $"{baseUri}/?table={Table?.TableNumber}";
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task TriggerPrint()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch { }
    }
}
