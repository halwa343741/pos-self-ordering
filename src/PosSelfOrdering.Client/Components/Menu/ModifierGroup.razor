@using PosSelfOrdering.Client.DTOs.Menu
@using PosSelfOrdering.Client.Extensions

<div class="modifier-group">
    <div class="modifier-group-header">
        <span class="modifier-group-title">@Group.Name</span>
        <span class="badge @(Group.IsRequired ? "badge-primary" : "badge-info")" style="font-size: 0.7rem;">
            @(Group.IsRequired ? "Wajib" : "Opsional")
            @if (Group.MaxSelections > 1)
            {
                <span>(Maks. @Group.MaxSelections)</span>
            }
        </span>
    </div>

    <div class="modifier-options">
        @foreach (var opt in Group.Options)
        {
            var isSelected = SelectedOptions.Any(o => o.Id == opt.Id);
            <div class="modifier-option-row @(isSelected ? "selected" : "")" @onclick="() => ToggleOption(opt)">
                <div class="modifier-label-wrap">
                    @if (Group.MaxSelections == 1)
                    {
                        <div class="custom-radio"></div>
                    }
                    else
                    {
                        <div class="custom-checkbox"></div>
                    }
                    <span style="font-weight: 600; color: var(--text-primary);">@opt.Name</span>
                </div>

                @if (opt.ExtraPrice > 0)
                {
                    <span style="font-weight: 700; color: var(--color-primary); font-size: 0.88rem;">
                        +@opt.ExtraPrice.ToIdr()
                    </span>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ModifierGroupDto Group { get; set; } = default!;
    [Parameter] public List<ModifierOptionDto> SelectedOptions { get; set; } = new();
    [Parameter] public EventCallback<List<ModifierOptionDto>> SelectedOptionsChanged { get; set; }

    private async Task ToggleOption(ModifierOptionDto option)
    {
        if (Group.MaxSelections == 1)
        {
            // Single select / Radio behavior
            SelectedOptions.RemoveAll(o => Group.Options.Any(grpOpt => grpOpt.Id == o.Id));
            SelectedOptions.Add(option);
        }
        else
        {
            // Multi select / Checkbox behavior
            var existing = SelectedOptions.FirstOrDefault(o => o.Id == option.Id);
            if (existing is not null)
            {
                SelectedOptions.Remove(existing);
            }
            else
            {
                var currentInThisGroup = SelectedOptions.Count(o => Group.Options.Any(grpOpt => grpOpt.Id == o.Id));
                if (currentInThisGroup < Group.MaxSelections)
                {
                    SelectedOptions.Add(option);
                }
            }
        }

        await SelectedOptionsChanged.InvokeAsync(SelectedOptions);
    }
}
