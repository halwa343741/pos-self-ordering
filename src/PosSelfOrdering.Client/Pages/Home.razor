@page "/"
@page "/table/{TableParam}"
@using PosSelfOrdering.Client.Services
@using PosSelfOrdering.Client.State
@inject ISessionService SessionService
@inject NavigationManager Nav

<div class="animate-fade-in" style="max-width: 480px; margin: 20px auto; display: flex; flex-direction: column; gap: 20px;">
    <!-- Welcome Header Banner -->
    <div class="glass-panel" style="padding: 28px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;">
        <div style="height: 90px; width: 100%; display: flex; align-items: center; justify-content: center;">
            <img src="images/logo-kedai-ja.svg" alt="Kedai J.A Logo" style="height: 90px; width: auto; object-fit: contain; filter: drop-shadow(0 4px 12px rgba(245, 158, 11, 0.3));" />
        </div>
        <div>
            <h2 style="font-size: 1.6rem; font-weight: 800; color: var(--text-primary);">Selamat Datang di Kedai J.A</h2>
            <p style="font-size: 0.9rem; margin-top: 6px; color: var(--text-secondary);">Pesan hidangan lezat dan minuman favorit Anda langsung dari meja dengan cepat & mudah.</p>
        </div>
    </div>

    <!-- Order Setup Card -->
    <div class="glass-panel" style="padding: 24px; display: flex; flex-direction: column; gap: 18px;">
        <h3 style="font-size: 1.1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
            Mulai Pemesanan
        </h3>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div style="background: var(--color-danger-bg); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.88rem;">
                @_errorMessage
            </div>
        }

        <!-- Order Type Selector (Dine-in vs Takeaway) -->
        <div class="form-group">
            <label class="form-label">Tipe Pemesanan</label>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <button type="button" 
                        class="btn @(_orderType == "DineIn" ? "btn-primary" : "btn-secondary")"
                        @onclick='() => _orderType = "DineIn"'>
                    <span>🪑</span>
                    <span>Makan di Sini (Dine-In)</span>
                </button>
                <button type="button" 
                        class="btn @(_orderType == "Takeaway" ? "btn-primary" : "btn-secondary")"
                        @onclick='() => _orderType = "Takeaway"'>
                    <span>🛍️</span>
                    <span>Bungkus (Takeaway)</span>
                </button>
            </div>
        </div>

        <!-- Table Number (Only for Dine-in) -->
        @if (_orderType == "DineIn")
        {
            <div class="form-group animate-fade-in">
                <label class="form-label">Nomor Meja</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" 
                           class="form-input" 
                           placeholder="Contoh: T-05" 
                           style="font-size: 1.1rem; font-weight: 700; text-transform: uppercase;"
                           @bind="_tableNumber" />
                    <button type="button" class="btn btn-secondary" style="white-space: nowrap;" @onclick="SimulateScanQr" title="Pindai QR Meja">
                        <span>📷 Scan QR</span>
                    </button>
                </div>
            </div>
        }

        <!-- Customer Name (Optional) -->
        <div class="form-group">
            <label class="form-label">Nama Pemesan (Opsional)</label>
            <input type="text" 
                   class="form-input" 
                   placeholder="Nama Anda untuk panggilan pesanan" 
                   @bind="_customerName" />
        </div>

        <button class="btn btn-primary btn-block" 
                style="margin-top: 8px; font-size: 1.05rem;" 
                disabled="@_isLoading" 
                @onclick="StartOrdering">
            @if (_isLoading)
            {
                <span>Memproses Sesi...</span>
            }
            else
            {
                <span>Buka Menu & Pesan Sekarang ➔</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public string? TableParam { get; set; }

    private string _orderType = "DineIn";
    private string _tableNumber = "T-05";
    private string _customerName = string.Empty;
    private bool _isLoading = false;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(TableParam))
        {
            _tableNumber = TableParam.ToUpper();
            _orderType = "DineIn";
        }
    }

    private void SimulateScanQr()
    {
        _tableNumber = $"T-0{Random.Shared.Next(1, 9)}";
    }

    private async Task StartOrdering()
    {
        _errorMessage = null;
        if (_orderType == "DineIn" && string.IsNullOrWhiteSpace(_tableNumber))
        {
            _errorMessage = "Silakan masukkan nomor meja Anda.";
            return;
        }

        _isLoading = true;
        try
        {
            var success = await SessionService.InitializeSessionAsync(
                _orderType == "Takeaway" ? "TAKEAWAY" : _tableNumber,
                _orderType,
                _customerName
            );

            if (success)
            {
                Nav.NavigateTo("/menu");
            }
            else
            {
                _errorMessage = "Gagal menghubungkan ke sesi restoran. Silakan coba lagi.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
