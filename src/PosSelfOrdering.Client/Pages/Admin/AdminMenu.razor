</style>

@code {
    private string activeTab = "menu";
    private List<MenuItemDto> menuItems = new();
    private List<CategoryDto> categories = new();
    private List<VoucherDto> vouchers = new();

    private string searchQuery = "";
    private string selectedCategory = "";
    private string selectedAvailabilityFilter = "all";

    // Modals
    private bool isMenuModalOpen = false;
    private MenuItemDto? selectedItemForEdit;

    private bool isVoucherModalOpen = false;
    private VoucherDto? selectedVoucherForEdit;

    private bool isDeleteModalOpen = false;
    private string deleteMessage = "";
    private string? deleteItemName;
    private Func<Task>? confirmDeleteAction;

    private IEnumerable<MenuItemDto> filteredMenuItems
    {
        get
        {
            var query = menuItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(selectedCategory))
            {
                query = query.Where(m => m.CategoryId.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedAvailabilityFilter == "available")
            {
                query = query.Where(m => m.IsAvailable);
            }
            else if (selectedAvailabilityFilter == "soldout")
            {
                query = query.Where(m => !m.IsAvailable);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(m =>
                    m.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    m.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.OnMenuCatalogUpdated += OnCatalogUpdated;
        Store.OnVouchersUpdated += OnVouchersUpdated;
        Broadcast.OnMenuUpdated += OnCatalogUpdated;

        await ReloadData();
    }

    private async Task ReloadData()
    {
        categories = Store.Categories.Values.OrderBy(c => c.DisplayOrder).ToList();
        menuItems = Store.MenuItems.Values.ToList();
        vouchers = (await AdminService.GetVouchersAsync()).ToList();
        StateHasChanged();
    }

    private void OnCatalogUpdated()
    {
        InvokeAsync(async () =>
        {
            await ReloadData();
        });
    }

    private void OnVouchersUpdated()
    {
        InvokeAsync(async () =>
        {
            await ReloadData();
        });
    }

    private string GetCategoryName(string catId)
    {
        return categories.FirstOrDefault(c => c.Id == catId)?.Name ?? catId;
    }

    private async Task HandleToggleStock(string itemId)
    {
        await AdminService.ToggleItemStockAsync(itemId);
        await ReloadData();
    }

    private void OpenAddMenuModal()
    {
        selectedItemForEdit = null;
        isMenuModalOpen = true;
    }

    private void OpenEditMenuModal(MenuItemDto item)
    {
        selectedItemForEdit = item;
        isMenuModalOpen = true;
    }

    private async Task HandleSaveMenu(UpsertMenuItemRequest request)
    {
        await AdminService.SaveMenuItemAsync(request);
        await ReloadData();
    }

    private void OpenDeleteMenuModal(MenuItemDto item)
    {
        deleteItemName = item.Name;
        deleteMessage = $"Menu '{item.Name}' akan dihapus dari katalog.";
        confirmDeleteAction = async () =>
        {
            await AdminService.DeleteMenuItemAsync(item.Id);
            await ReloadData();
        };
        isDeleteModalOpen = true;
    }

    private void OpenAddVoucherModal()
    {
        selectedVoucherForEdit = null;
        isVoucherModalOpen = true;
    }

    private void OpenEditVoucherModal(VoucherDto voucher)
    {
        selectedVoucherForEdit = voucher;
        isVoucherModalOpen = true;
    }

    private async Task HandleSaveVoucher(VoucherDto voucher)
    {
        await AdminService.SaveVoucherAsync(voucher);
        await ReloadData();
    }

    private async Task HandleToggleVoucher(VoucherDto voucher)
    {
        var updated = voucher with { IsActive = !voucher.IsActive };
        await AdminService.SaveVoucherAsync(updated);
        await ReloadData();
    }

    private void OpenDeleteVoucherModal(VoucherDto voucher)
    {
        deleteItemName = voucher.Code;
        deleteMessage = $"Voucher '{voucher.Code}' akan dihapus permanen.";
        confirmDeleteAction = async () =>
        {
            await AdminService.DeleteVoucherAsync(voucher.Code);
            await ReloadData();
        };
        isDeleteModalOpen = true;
    }

    private async Task HandleConfirmDelete()
    {
        if (confirmDeleteAction != null)
        {
            await confirmDeleteAction();
        }
    }

    public void Dispose()
    {
        Store.OnMenuCatalogUpdated -= OnCatalogUpdated;
        Store.OnVouchersUpdated -= OnVouchersUpdated;
        Broadcast.OnMenuUpdated -= OnCatalogUpdated;
    }
}
