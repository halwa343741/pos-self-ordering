@page "/admin/menu"
@layout AdminLayout
@inject IAdminService AdminService
@inject SharedPosDataStore Store
@inject BroadcastChannelService Broadcast
@implements IDisposable

<div class="menu-mgmt-container">
    <!-- HEADER -->
    <div class="mgmt-header">
        <div class="header-titles">
            <h1 class="page-title">Kelola Menu & Voucher</h1>
            <p class="page-subtitle">Kontrol harga, status ketersediaan stok seketika, dan diskon promo</p>
        </div>

        <div class="header-tabs">
            <button type="button" class="tab-btn @(activeTab == "menu" ? "active" : "")" @onclick="@(() => activeTab = "menu")">
                <span>🍔 Katalog Menu (@menuItems.Count)</span>
            </button>
            <button type="button" class="tab-btn @(activeTab == "voucher" ? "active" : "")" @onclick="@(() => activeTab = "voucher")">
                <span>🏷️ Promo Voucher (@vouchers.Count)</span>
            </button>
        </div>
    </div>

    @if (activeTab == "menu")
    {
        <!-- MENU TAB -->
        <div class="menu-tab-content">
            <!-- CONTROLS & STATS BAR -->
            <div class="controls-bar">
                <div class="filter-group">
                    <div class="search-input-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" class="search-field" placeholder="Cari nama menu..."
                               value="@searchQuery"
                               @oninput="@(e => searchQuery = e.Value?.ToString() ?? "")" />
                    </div>

                    <select class="category-select" @bind="selectedCategory">
                        <option value="">Semua Kategori</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>

                    <select class="status-select" @bind="selectedAvailabilityFilter">
                        <option value="all">Semua Status</option>
                        <option value="available">🟢 Tersedia Saja</option>
                        <option value="soldout">🔴 Habis Saja</option>
                    </select>
                </div>

                <div class="actions-group">
                    <div class="stock-stats">
                        <span class="stat-tag ready">Ready: <strong>@menuItems.Count(m => m.IsAvailable)</strong></span>
                        <span class="stat-tag soldout">Habis: <strong>@menuItems.Count(m => !m.IsAvailable)</strong></span>
                    </div>

                    <button type="button" class="btn-add-primary" @onclick="OpenAddMenuModal">
                        <span>➕ Tambah Menu</span>
                    </button>
                </div>
            </div>

            <!-- MENU GRID / TABLE -->
            <div class="menu-items-grid">
                @if (!filteredMenuItems.Any())
                {
                    <div class="empty-results-box">
                        <span class="empty-icon">🍽️</span>
                        <p>Tidak ada hidangan yang sesuai dengan filter pencarian.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in filteredMenuItems)
                    {
                        <div class="admin-menu-card @(!item.IsAvailable ? "item-soldout" : "")">
                            <div class="item-img-container">
                                <img src="@item.ImageUrl" alt="@item.Name" class="item-img" loading="lazy" />
                                @if (!item.IsAvailable)
                                {
                                    <div class="soldout-overlay">
                                        <span>HABIS</span>
                                    </div>
                                }
                                <div class="item-badges-overlay">
                                    @if (item.IsBestSeller)
                                    {
                                        <span class="badge-star">⭐ Best Seller</span>
                                    }
                                    @if (item.IsSpicy)
                                    {
                                        <span class="badge-spicy">🌶️ Pedas</span>
                                    }
                                </div>
                            </div>

                            <div class="item-content-body">
                                <div class="item-category-tag">@GetCategoryName(item.CategoryId)</div>
                                <h3 class="item-name">@item.Name</h3>
                                <p class="item-desc">@item.Description</p>
                                <div class="item-price">@item.BasePrice.ToIdr()</div>

                                @if (item.ModifierGroups != null && item.ModifierGroups.Any())
                                {
                                    <div class="item-mods-summary">
                                        <span class="mods-icon">⚙️</span>
                                        <span>@item.ModifierGroups.Count grup modifier</span>
                                    </div>
                                }
                            </div>

                            <!-- 1-CLICK INSTANT SOLD-OUT SWITCH & ACTIONS -->
                            <div class="item-actions-footer">
                                <div class="switch-container">
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@item.IsAvailable"
                                               @onchange="@(() => HandleToggleStock(item.Id))" />
                                        <span class="slider round"></span>
                                    </label>
                                    <span class="switch-label @(item.IsAvailable ? "lbl-ready" : "lbl-soldout")">
                                        @(item.IsAvailable ? "Tersedia" : "Habis")
                                    </span>
                                </div>

                                <div class="card-btn-group">
                                    <button type="button" class="btn-icon edit" @onclick="@(() => OpenEditMenuModal(item))" title="Edit Menu">
                                        ✏️
                                    </button>
                                    <button type="button" class="btn-icon delete" @onclick="@(() => OpenDeleteMenuModal(item))" title="Hapus Menu">
                                        🗑️
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <!-- VOUCHER TAB -->
        <div class="voucher-tab-content">
            <div class="controls-bar">
                <div class="filter-group">
                    <p class="voucher-hint">Kelola kode promo yang dapat digunakan pelanggan pada saat checkout.</p>
                </div>
                <button type="button" class="btn-add-primary" @onclick="OpenAddVoucherModal">
                    <span>➕ Tambah Voucher Promo</span>
                </button>
            </div>

            <div class="vouchers-grid">
                @if (!vouchers.Any())
                {
                    <div class="empty-results-box">
                        <span class="empty-icon">🏷️</span>
                        <p>Belum ada promo voucher aktif.</p>
                    </div>
                }
                else
                {
                    @foreach (var v in vouchers)
                    {
                        <div class="voucher-card @(!v.IsActive ? "voucher-inactive" : "")">
                            <div class="voucher-header">
                                <div class="voucher-code-badge">
                                    <span class="code-text">@v.Code</span>
                                </div>
                                <span class="voucher-status-pill @(v.IsActive ? "active" : "inactive")">
                                    @(v.IsActive ? "🟢 Aktif" : "🔴 Nonaktif")
                                </span>
                            </div>

                            <div class="voucher-details">
                                <p class="voucher-desc">@v.Description</p>
                                <div class="voucher-calc-row">
                                    <span class="discount-val">
                                        @(v.IsPercentage ? $"Diskon {v.DiscountAmount}%" : $"Potongan {v.DiscountAmount.ToIdr()}")
                                    </span>
                                    <span class="min-order">Min: @v.MinOrderAmount.ToIdr()</span>
                                </div>
                            </div>

                            <div class="voucher-footer">
                                <button type="button" class="btn-action-sm toggle" @onclick="@(() => HandleToggleVoucher(v))">
                                    @(v.IsActive ? "Nonaktifkan" : "Aktifkan")
                                </button>
                                <button type="button" class="btn-action-sm edit" @onclick="@(() => OpenEditVoucherModal(v))">
                                    Edit
                                </button>
                                <button type="button" class="btn-action-sm delete" @onclick="@(() => OpenDeleteVoucherModal(v))">
                                    Hapus
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- MODALS -->
<MenuEditorModal IsOpen="isMenuModalOpen"
                 ExistingItem="selectedItemForEdit"
                 Categories="categories"
                 OnClose="@(() => isMenuModalOpen = false)"
                 OnSave="HandleSaveMenu" />

<VoucherEditorModal IsOpen="isVoucherModalOpen"
                    ExistingVoucher="selectedVoucherForEdit"
                    OnClose="@(() => isVoucherModalOpen = false)"
                    OnSave="HandleSaveVoucher" />

<DeleteConfirmModal IsOpen="isDeleteModalOpen"
                    Title="Konfirmasi Hapus"
                    Message="@deleteMessage"
                    ItemName="@deleteItemName"
                    OnClose="@(() => isDeleteModalOpen = false)"
                    OnConfirm="HandleConfirmDelete" />

<style>
